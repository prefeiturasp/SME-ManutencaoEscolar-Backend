# Django Settings
DJANGO_SECRET_KEY=sua-chave-secreta-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Usuário utilizado para conectar ao banco de dados
POSTGRES_USER=seu-usuario
POSTGRES_PASSWORD=sua-senha
POSTGRES_HOST=postgres
POSTGRES_PORT=sua-porta-para-acesso-ao-banco
POSTGRES_DB=nome-do-banco
URL_BANCO_POSTGRES=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Porta onde o Django ficará disponível no navegador
PORT_WEB=sua-porta-para-aplicacao

# Porta utilizada pelo Debugpy para depuração remota (VS Code/PyCharm)
PORT_DEBUGPY=sua-porta-para-debug
